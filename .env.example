# ========= 明辨 MINGBIAN · 环境配置模板 =========
# 复制为 .env 后填入真实密钥。.env 已被 .gitignore 忽略，不会提交到 git。

# 主引擎固定为 infini。比赛前置准入条件要求后端通过 InfiniSynapse Server API 调用，
# 且调用日志可在平台后台查验——换成别的引擎就不满足准入条件了。
PRIMARY_ENGINE=infini

# ---- InfiniSynapse 官方 Server API（主引擎）----
INFINI_API_KEY=在这里填入你的_sk-xxxx
INFINI_BASE_URL=https://app.infinisynapse.cn
INFINI_MODEL=deepseek-v4-pro
INFINI_ENABLE_WEBSEARCH=true
INFINI_TIMEOUT=300

# ---- MiniMax 降级通道（Infini 不可用时接管，界面会明确标注「已降级」）----
MINIMAX_API_KEY=在这里填入你的_MiniMax_Key
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7

# ---- 博查 Web Search（主检索通道）----
# 不配也能跑：会自动退到搜狗 / 百度 / 360 的 HTML 抓取兜底，
# 但拿不到发布时间与长摘要，来源可信度打分会因此偏低。
BOCHA_API_KEY=在这里填入你的_sk-xxxx
BOCHA_BASE_URL=https://api.bocha.cn/v1
BOCHA_RERANK_MODEL=gte-rerank

# ---- 服务端口（只监听本机，走 nginx 反代；项目三槽位，Anker 的 8766 不动）----
PORT=8767
HOST=127.0.0.1
ANALYZE_TIMEOUT=300
