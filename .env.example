# ========= 司南 SINAN · 环境配置模板 =========
# 复制为 .env 后填入真实密钥。.env 已被 .gitignore 忽略，不会提交到 git。
PRIMARY_ENGINE=infini

# ---- InfiniSynapse 官方 API（比赛要求，主用）----
INFINI_API_KEY=在这里填入你的_sk-xxxx
INFINI_BASE_URL=https://app.infinisynapse.cn
INFINI_ENABLE_WEBSEARCH=true

# ---- MiniMax 兜底（万一 InfiniSynapse 卡住自动切换）----
MINIMAX_API_KEY=在这里填入你的_MiniMax_Key
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7

# ---- 服务端口（只监听本机，走 nginx 反代；项目三槽位）----
PORT=8767
HOST=127.0.0.1
ANALYZE_TIMEOUT=300
