#!/usr/bin/expect -f
# 用法：scp.exp <本地路径> <远程路径>
set timeout 1800
set src [lindex $argv 0]
set dst [lindex $argv 1]
set pass $env(MB_SSH_PASS)
spawn scp -o StrictHostKeyChecking=no -r $src root@47.119.112.225:$dst
expect {
  "password:" { send "$pass\r"; exp_continue }
  eof
}
catch wait result
exit [lindex $result 3]
